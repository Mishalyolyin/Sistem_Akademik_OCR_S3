# Salin jadi .env lalu isi. Dipakai docker-compose.prod.yml.

# Database
DB_NAME=pembayaran
DB_USER=pembayaran
DB_PASSWORD=ganti-dengan-kata-sandi-kuat

# RabbitMQ
RABBITMQ_USER=pembayaran
RABBITMQ_PASSWORD=ganti-dengan-kata-sandi-kuat

# Kunci penandatangan JWT. WAJIB minimal 32 karakter dan rahasia.
# Buat dengan: openssl rand -base64 48
JWT_SECRET=ganti-rahasia-ini-minimal-32-karakter-untuk-hs256

# Admin pertama, dibuat sekali saat tabel pengguna masih kosong.
# Tidak ada endpoint pembuat pengguna di sistem ini, jadi tanpa ini pemasangan
# baru tidak punya jalan masuk sama sekali.
APP_ADMIN_EMAIL=admin@kampus.ac.id
APP_ADMIN_PASSWORD=ganti-dengan-kata-sandi-kuat
APP_ADMIN_NAME=Admin Keuangan

# Alamat yang diakses pengguna
APP_URL=https://pembayaran.kampus.ac.id
API_URL=https://pembayaran.kampus.ac.id/api

# Cookie sesi hanya melewati HTTPS. Setel false HANYA kalau sedang menguji
# lewat http:// tanpa sertifikat.
COOKIE_SECURE=true
